# StatGPT / MoSPIStatAI — Environment Configuration
# ─────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────────
# Supported: gemini (default) | openrouter | groq
LLM_PROVIDER=gemini

# Gemini (https://aistudio.google.com) — free tier available
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter (https://openrouter.ai) — optional alternative
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=google/gemini-flash-1.5

# Groq (https://console.groq.com) — optional alternative
# LLM_PROVIDER=groq
# GROQ_API_KEY=your_groq_key_here
# GROQ_MODEL=llama-3.1-70b-versatile

# ── RAG / Knowledge Layer ─────────────────────────
# Embedding model (sentence-transformers, auto-downloaded on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# FAISS index location (relative to project root)
FAISS_INDEX_PATH=knowledge/db/faiss.index
FAISS_META_PATH=knowledge/db/metadata.json

# Number of top chunks to retrieve
RAG_TOP_K=8

# Minimum confidence threshold (0.0 – 1.0)
RAG_MIN_CONFIDENCE=0.3
